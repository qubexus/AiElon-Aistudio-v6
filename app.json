{
  "expo": {
    "name": "Ask Elon",
    "slug": "ask-elon",
    "scheme": "askelon",
    "version": "7.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F8FAFC",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.askelon.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSMicrophoneUsageDescription": "Ask Elon uses the microphone to dictate your message.",
        "NSCameraUsageDescription": "Ask Elon uses the camera to photograph payslips, contracts and other evidence for your case.",
        "NSPhotoLibraryUsageDescription": "Ask Elon needs access to your photos so you can attach evidence to a case.",
        "NSPhotoLibraryAddUsageDescription": "Ask Elon saves photos you capture to your library when you ask it to."
      }
    },
    "android": {
      "package": "uk.askelon.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Ask Elon to record your voice so it can turn your words into a message.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ask Elon to use the camera so you can photograph documents for your case.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ask Elon to access your photos so you can attach evidence to a case.",
          "cameraPermission": "Allow Ask Elon to use the camera so you can photograph documents for your case."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F59E42"
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}