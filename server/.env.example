# Google Gemini API key (required for AI answers, transcription and tone analysis).
GEMINI_API_KEY=

# Port the API listens on (default 3000).
PORT=3000

# Gemini model used for chat, streaming and analysis.
GEMINI_MODEL=gemini-4-hydrogen

# Optional: Resend API key for e-mailing a chat transcript.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
