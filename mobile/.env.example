# Base URL of the Ask Elon Express backend (server.ts).
# In development you can leave it empty: the app derives the LAN IP from the Metro host.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:3000

# Google OAuth client IDs (used once native sign-in is wired to the backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# RevenueCat (Elon PRO subscription)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
